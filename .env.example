# Optional: only needed for the live managed custom StateGraph demo.
# Use a model ID from build.nvidia.com.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=
NVIDIA_API_KEY=
# OPENAI_API_KEY also works; NVIDIA_API_KEY is used as a fallback.
OPENAI_API_KEY=

# Local output files used by the demo runner.
NEMO_RELAY_TRACE_FILE=outputs/trace_events.jsonl
NEMO_RELAY_SUMMARY_FILE=outputs/trace_summary.md
